{
  "link_file": "link.txt",
  "engine_mode": "camoufox",
  "headless_mode": true,
  "max_concurrent_browsers": 2,
  "start_stagger_delay_sec": 2.0,
  "watch_duration_sec": 180,
  "execution_mode": "loop",
  "round_delay_sec": 10,
  "max_proxy_retries": 5,
  "prevent_windows_sleep": true,
  "proxy_pool": {
    "proxy_file": "proxies.txt",
    "default_protocol": "http",
    "rotation_mode": "random"
  }
}
